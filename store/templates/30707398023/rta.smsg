        <BarCodeFont xmlns="http://www.afip.com.ar/fe"></BarCodeFont>
      </Autorizacion>
      <CAE>{ivstrAuthCode}</CAE>
    </Status>
  </Authorization>
  <Status>
    <Code>{ivstr3o4}</Code>
    <Description>{ivstrAuthDsc}</Description>
    <TimeStamp>{ivdtmNode}</TimeStamp>
    <TrackId>{ivstrTrackId}</TrackId>
    <Comments>{ivstrAuthObs}</Comments>
