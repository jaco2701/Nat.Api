        <FechaVtoAut xmlns="http://www.afip.com.ar/fe">{ivdtmAuthVenc}</FechaVtoAut>
        <TimeStampAut xmlns="http://www.afip.com.ar/fe">{ivdtmNode}</TimeStampAut>
